{
    "version": "0.2",
    "language": "en,pl",
    "ignorePaths": [
        "**/*.ipynb",
        "**/Notebooks/**",
        "**/*.aux",
        "**/*.bbl",
        "**/*.blg",
        "**/*.fls",
        "**/*.fdb_latexmk",
        "**/*.toc",
        "**/*.out",
        "**/*.log",
        "**/*.synctex.gz",
        "**/*.bib"
    ],
    "enabledFileTypes": {
        "markdown": true,
        "python": true,
        "jupyter": true,
        "plaintext": true
    },
    "dictionaryDefinitions": [
        {
            "name": "ltex-custom-dictionary",
            "path": "./.vscode/ltex.dictionary.pl-PL.txt",
            "addWords": true
        }
    ],
    "dictionaries": [
        "ltex-custom-dictionary"
    ],
    "words": [
        "binarizacji",
        "rekomendacyjnej"
    ]
}
