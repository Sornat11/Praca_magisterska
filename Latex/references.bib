  author = {Doligalski, Tymoteusz and Goli{\'n}ski, Micha{\l} and Bernardelli, Micha{\l} and Szpringer, W{\l}odzimierz and Malgorzata, Godlewska and Szulc, Rados{\l}aw and Piech, Krzysztof and Janowska, Anetta and Koczetkow, Blazej and Lech, Lukasz and Sarna, Nikodem and Mr{\'o}z, Bogdan and Siejka, Aneta and Szymkiewicz, Weronika and Kowalczyk, Justyna and Trzebi{\'n}ski, Wojciech and Niedzi{\'o}{\l}ka, Tomasz and Zdunkiewicz, Wojciech and Kowalczyk, Marcin and Sobolewska, Sylwia},
  year = 2024,
  month = apr,
  abstract = {Ksi\k a\.zka do pobrania jako pdf. Kliknij [Download full-text PDF], aby pobra\'c ksi\k a\.zk\k e. Platformy internetowe osi\k agn\k e\l y status centralnych punkt\'ow gospodarki cyfrowej w ci\k agu zaledwie dw\'och dekad. U\l atwi\l y komunikacj\k e, wsp\'o\l prac\k e i handel na ca\l ym \'swiecie. Wp\l yn\k e\l y na funkcjonowanie rynk\'ow, przedsi\k ebiorstw i konsument\'ow, sk\l aniaj\k ac dostawc\'ow i u\.zytkownik\'ow do dzia\l ania w ich ekosystemach zgodnie z ustalonymi przez nie regu\l ami. Zmieni\l y nie tylko gospodark\k e, ale i liczne obszary naszej wsp\'o\l czesno\'sci: kultur\k e, polityk\k e i nasze codzienne zachowania. Najpot\k e\.zniejsze z nich, osi\k agaj\k ac w swych dziedzinach pozycj\k e monopolistyczn\k a lub silnie dominuj\k ac\k a, sta\l y si\k e najdro\.zszymi i niezwykle dochodowymi firmami. Ich pot\k ega zacz\k e\l a budzi\'c fascynacj\k e, ale i jednocze\'snie rosn\k ace obawy pozosta\l ych firm, instytucji pa\'nstwowych oraz nas, u\.zytkownik\'ow. Staj\k ac si\k e technologiami og\'olnego zastosowania, uzale\.zni\l y od siebie ludzi i istotne obszary naszej wsp\'o\l czesno\'sci. Z wielu z nich korzystamy codziennie wszyscy. Niniejsza ksi\k a\.zka jest efektem konferencji, kt\'ora odby\l a si\k e w grudniu 2022 r. w Szkole G\l\'ownej Handlowej w Warszawie przy wsp\'o\l pracy z DELab Uniwersytetu Warszawskiego. Konferencja ta by\l a okazj\k a do wymiany pogl\k ad\'ow rosn\k acej spo\l eczno\'sci badaczy, kt\'orzy z ro\.znych perspektyw i u\.zywaj\k ac r\'o\.znych metodyk badaj\k a tematyk\k e platform cyfrowych w r\'o\.znorakich kontekstach, takich jak: modele biznesu, nowe zastosowania, skala i skutki oddzia\l ywania, pot\k ega ekonomiczna czy wp\l yw na u\.zytkownik\'ow. Pe\l ni\k ac funkcj\k e redaktor\'ow, niczym operatorzy platformy, mieli\'smy wp\l yw na charakter rozdzia\l\'ow w ksi\k a\.zce. Zdecydowali\'smy si\k e na teksty kr\'otkie, kt\'ore przypominaj\k a form\k e komunikacji akademickiej okre\'slan\k a jako research letters. Charakteryzuj\k a si\k e one koncentracj\k a na g\l\'ownej tezie, a mniejszy nacisk k\l ad\k a na analiz\k e przegl\k adu literatury. Pragniemy bowiem umo\.zliwi\'c Czytelnikom zapoznanie si\k e z r\'o\.znymi pogl\k adami i nowatorskimi pomys\l ami w spos\'ob zwi\k ez\l y, lecz pe\l en tre\'sci. Z uwagi na du\.z\k a liczb\k e wsp\'o\l autor\'ow reprezentuj\k acych r\'o\.zne dyscypliny i stosuj\k acych r\'o\.znorakie metodyki badawcze nie d\k a\.zyli\'smy do pe\l nego ujednolicenia siatki poj\k e\'c, ani narzucania jednego, okre\'slonego sposobu my\'slenia o platformach. Wr\k ecz przeciwnie, chcieli\'smy stworzy\'c w naszej ksi\k a\.zce przestrze\'n dla r\'o\.znorodnych idei, teorii i praktycznych podej\'s\'c, kt\'ore pozwalaj\k a na lepsze zrozumienie tego obszaru bada\'n. To tak\.ze odpowiada modelowi platformy, kt\'orej u\.zytkownicy odgrywaj\k a r\'o\.znorakie, cz\k esto nawet przeciwstawne role.},
  isbn = {978-83-8030-664-6},
  file = {C:\Users\jakub\Zotero\storage\RDPUK3YB\Doligalski et al. - 2024 - Platformy cyfrowe. Model biznesu, zastosowania, użytkownicy (książka do pobrania).pdf}
}

